---
import BookACallForm from "../../components/BookACallForm.astro";
import Footer from "../../components/footer.astro";
import Navigation from "../../components/navigation.astro";
import Pill from "../../components/Pill.astro";
import Section from "../../components/Section.astro";
import MaturityResults from "../../components/maturity-tool/MaturityResults";
import Base from "../../layouts/base.astro";
import { decodeAnswers } from "../../data/maturityAssessment";
import "../../styles/main.css";

const {
  ogImage = "https://www.crocoder.dev/staff-augmentation-metadata-img.png",
} = Astro.props;

const answers = decodeAnswers(Astro.url.searchParams.get("a"));
---

<Base className="bg-white" ogImage={ogImage}>
  <Navigation />

  <Section className="!pt-[110px] bg-white md:!pt-[140px] !pb-8 md:!pb-12">
    {
      answers ? (
        <div class="max-w-4xl mx-auto">
          <MaturityResults answers={answers} client:load />
        </div>
      ) : (
        <div class="max-w-2xl mx-auto text-center flex flex-col items-center gap-5">
          <Pill>Technical maturity assessment</Pill>
          <h1 class="text-h1-sm sm:text-h1 font-medium tracking-tight text-dark">
            We couldn't read those results
          </h1>
          <p class="text-text text-base md:text-lg leading-7">
            The results link looks incomplete or invalid. Take the free 15-minute
            self-assessment to get your maturity profile.
          </p>
          <a
            href="/technical-maturity-assessment"
            class="inline-block bg-crocoder-yellow rounded-md px-[25px] py-4 text-center text-contrast text-base font-medium hover:opacity-90 w-fit"
          >
            Start the assessment
          </a>
        </div>
      )
    }
  </Section>

  <BookACallForm calLink="team/crocoder/hello" eventType="hello" deferLoad>
    <span slot="title">
      Ready to close the <span class="text-crocoder-yellow">gap?</span>
    </span>
  </BookACallForm>

  <Footer />
</Base>
